# Copy to .env.local for local development. NEVER commit real values.
# Production/preview values live in Vercel → Project → Settings → Environment Variables.
# Only FREE services. Accounts for these APIs are usually 18+ by their terms — an adult should create them.

# ─── Vision + description: Google Gemini API, free tier ─────────────
# Key: https://aistudio.google.com/apikey  (limits per project: https://aistudio.google.com/rate-limit)
# Several keys may be listed, comma-separated: the visual check moves on to the next one (#124, #125).
GEMINI_API_KEY=
# The "-latest" aliases always point to a live model (a retired numbered model answers 404) — same as lib/env.ts.
# What your key can actually use: curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
VISION_MODEL=gemini-flash-lite-latest
# Used only when the vision model is overloaded (503) or gone (404).
VISION_MODEL_FALLBACK=gemini-flash-latest
DESCRIPTION_MODEL=gemini-flash-latest

# ─── Web image search: Serper, 2,500 free queries (no card) ─────────
# Optional: without a key the web_search source is skipped honestly.
SERPER_API_KEY=

# ─── Openverse: free CC-licensed photos (incl. Flickr) — issue #33 ──
# Optional: register an app at https://api.openverse.org/v1/ (email verification) for 10k requests/day.
# Openverse hands these out as client_id / client_secret; those bare names are read too, so credentials
# already stored under them do not have to be re-entered (#111). The prefixed names below win.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# ─── Cache / rate limits: Upstash Redis free tier (Vercel → Storage) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Wikimedia (required User-Agent with contact URL; no personal emails) ─
WIKIMEDIA_USER_AGENT="CampusProof/0.1 (https://github.com/Amir10202010/campusproof)"

# ─── Pipeline knobs ─────────────────────────────────────────────────
PIPELINE_VERSION=0.1.0
# Protects the free quotas (Gemini requests/day, Serper credits).
MAX_FRESH_PROFILES_PER_DAY=150
# Fresh runs per client IP in 10 minutes. Judges in one room often share an IP.
FRESH_RUNS_PER_CLIENT=40
