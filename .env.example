# Copy to .env.local for local development. NEVER commit real values.
# Production/preview values live in Vercel → Project → Settings → Environment Variables.

# ─── Vision + description (Claude API) ─────────────────────────────
ANTHROPIC_API_KEY=
# Decided by spike S4 (docs/architecture.md §16). Candidates: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
VISION_MODEL=claude-opus-5

# ─── Web image search ───────────────────────────────────────────────
# serper (2,500 free queries, no card) | brave (card required)
WEB_SEARCH_PROVIDER=serper
SERPER_API_KEY=
BRAVE_API_KEY=

# ─── Cache / rate limits (Upstash Redis via Vercel Marketplace) ─────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Wikimedia (required User-Agent with contact URL; no personal emails) ─
WIKIMEDIA_USER_AGENT="CampusProof/0.1 (https://github.com/Amir10202010/campusproof)"

# ─── Pipeline knobs ─────────────────────────────────────────────────
PIPELINE_VERSION=0.1.0
MAX_FRESH_PROFILES_PER_DAY=400
