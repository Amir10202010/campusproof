{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run fix)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Bash(npm ci)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git pull --rebase *)",
      "Bash(git rebase --continue)",
      "Bash(git push -u origin *)",
      "Bash(git worktree *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue create *)",
      "Bash(gh pr checks * --watch)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(pip install *)",
      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/pip install *)",
      "Bash(curl -s http://localhost:3000/*)",
      "Bash(curl -sN http://localhost:3000/*)",
      "Bash(curl -s https://campusproof.vercel.app/*)",
      "Bash(curl -sN https://campusproof.vercel.app/*)",
      "Bash(node scripts/qa/*)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npx shadcn@latest add *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Edit(./lib/types.ts)",
      "Edit(./package.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.vercel/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(vercel env pull *)",
      "Bash(npx vercel env pull *)",
      "Bash(git push -u origin main)",
      "Bash(git push --set-upstream origin main)"
    ]
  }
}
